<Component xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:noesis="clr-namespace:NoesisGUIExtensions"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d">
  <noesis:LayoutScaler ReferenceResolution="1080,1920">
    <Grid x:Name="ContentContainer" Margin="48,240,48,120">
      <!-- System reserved zones (portrait) -->
      <Grid Width="220" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top"/>
      <Grid Width="220" Height="100" HorizontalAlignment="Right" VerticalAlignment="Top"/>

      <!-- TOP STATUS BAR: Timer + Territory Score (~6% of screen) -->
      <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0">
        <!-- AI Base HP -->
        <Border Background="#44FF3333" CornerRadius="8" Padding="12,4" Margin="0,0,0,4"
                HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Enemy Base: " Foreground="#FFFF6666" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Path=aiHPText}" Foreground="#FFFFFFFF" FontSize="16"
                       FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Timer + Score row -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Border Background="#88000000" CornerRadius="10" Padding="16,6" Margin="0,0,8,0">
            <TextBlock Text="{Binding Path=timerText}" Foreground="#FFFFFFFF" FontSize="28"
                       FontWeight="Bold" HorizontalAlignment="Center"/>
          </Border>
          <Border Background="#66000000" CornerRadius="8" Padding="12,6">
            <TextBlock Text="{Binding Path=scoreText}" Foreground="#FFFFFFFF" FontSize="18"
                       FontWeight="Bold" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </StackPanel>

      <!-- BOTTOM INFO BAR: Coins + Player HP (~10% of screen) -->
      <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4">
        <!-- Player Base HP -->
        <Border Background="#443366FF" CornerRadius="8" Padding="12,4" HorizontalAlignment="Center"
                Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Your Base: " Foreground="#FF6699FF" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Path=playerHPText}" Foreground="#FFFFFFFF" FontSize="16"
                       FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- Coins -->
        <Border Background="#88000000" CornerRadius="10" Padding="16,6" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Coins: " Foreground="#FFFFCC00" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Path=coinText}" Foreground="#FFFFFFFF" FontSize="22"
                       FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </noesis:LayoutScaler>
</Component>
