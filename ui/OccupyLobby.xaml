<Component xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:noesis="clr-namespace:NoesisGUIExtensions"
           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
           mc:Ignorable="d">
  <noesis:LayoutScaler ReferenceResolution="1080,1920">
    <!-- Full-screen dark background -->
    <Grid Background="#FF1A1A2E"/>

    <Grid x:Name="ContentContainer" Margin="48,240,48,120">
      <!-- System reserved zones (portrait) -->
      <Grid Width="220" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top"/>
      <Grid Width="220" Height="100" HorizontalAlignment="Right" VerticalAlignment="Top"/>

      <!-- Main content -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="60"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- TOP: Gold coin display -->
        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                CornerRadius="16" Padding="16,8" Margin="0,0,10,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FF3D2B00" Offset="0"/>
              <GradientStop Color="#FF5C4200" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="G" Foreground="#FFFFD700" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Path=goldText}" Foreground="#FFFFFFFF" FontSize="22"
                       FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- TITLE -->
        <TextBlock Grid.Row="1" Text="Occupy Master" Foreground="#FFFFFFFF" FontSize="36"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- CENTER: 2x2 Card Grid -->
        <UniformGrid Grid.Row="2" Rows="2" Columns="2" Margin="10,0,10,10">
          <!-- Card 1: Spearman -->
          <Border CornerRadius="12" Margin="6" Padding="10">
            <Border.Background>
              <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FF2A3A5E" Offset="0"/>
                <GradientStop Color="#FF1A2540" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="[Sword]" Foreground="#FF88BBFF" FontSize="32"
                         HorizontalAlignment="Center" Margin="0,4,0,4"/>
              <TextBlock Text="Spearman" Foreground="#FFFFFFFF" FontSize="18"
                         FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Path=card1Level}" Foreground="#FFAAAAFF" FontSize="14"
                         HorizontalAlignment="Center" Margin="0,4,0,2"/>
              <TextBlock Text="{Binding Path=card1Shards}" Foreground="#FF888888" FontSize="13"
                         HorizontalAlignment="Center"/>
              <Border CornerRadius="8" Padding="12,6" Margin="0,6,0,0"
                      Background="#FF334488" HorizontalAlignment="Center">
                <TextBlock Text="Upgrade" Foreground="#FFCCDDFF" FontSize="13"
                           HorizontalAlignment="Center"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Card 2: Archer -->
          <Border CornerRadius="12" Margin="6" Padding="10">
            <Border.Background>
              <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FF3A5E2A" Offset="0"/>
                <GradientStop Color="#FF1A4020" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="[Bow]" Foreground="#FF88FF88" FontSize="32"
                         HorizontalAlignment="Center" Margin="0,4,0,4"/>
              <TextBlock Text="Archer" Foreground="#FFFFFFFF" FontSize="18"
                         FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Path=card2Level}" Foreground="#FFAAFFAA" FontSize="14"
                         HorizontalAlignment="Center" Margin="0,4,0,2"/>
              <TextBlock Text="{Binding Path=card2Shards}" Foreground="#FF888888" FontSize="13"
                         HorizontalAlignment="Center"/>
              <Border CornerRadius="8" Padding="12,6" Margin="0,6,0,0"
                      Background="#FF338844" HorizontalAlignment="Center">
                <TextBlock Text="Upgrade" Foreground="#FFCCFFDD" FontSize="13"
                           HorizontalAlignment="Center"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Card 3: Tower -->
          <Border CornerRadius="12" Margin="6" Padding="10">
            <Border.Background>
              <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FF5E3A2A" Offset="0"/>
                <GradientStop Color="#FF402A1A" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="[Tower]" Foreground="#FFFFCC88" FontSize="32"
                         HorizontalAlignment="Center" Margin="0,4,0,4"/>
              <TextBlock Text="Tower" Foreground="#FFFFFFFF" FontSize="18"
                         FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Path=card3Level}" Foreground="#FFFFDDAA" FontSize="14"
                         HorizontalAlignment="Center" Margin="0,4,0,2"/>
              <TextBlock Text="{Binding Path=card3Shards}" Foreground="#FF888888" FontSize="13"
                         HorizontalAlignment="Center"/>
              <Border CornerRadius="8" Padding="12,6" Margin="0,6,0,0"
                      Background="#FF885533" HorizontalAlignment="Center">
                <TextBlock Text="Upgrade" Foreground="#FFFFEECC" FontSize="13"
                           HorizontalAlignment="Center"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Card 4: Mine -->
          <Border CornerRadius="12" Margin="6" Padding="10">
            <Border.Background>
              <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FF5E5E2A" Offset="0"/>
                <GradientStop Color="#FF40401A" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="[Mine]" Foreground="#FFFFFFAA" FontSize="32"
                         HorizontalAlignment="Center" Margin="0,4,0,4"/>
              <TextBlock Text="Mine" Foreground="#FFFFFFFF" FontSize="18"
                         FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Path=card4Level}" Foreground="#FFFFFFCC" FontSize="14"
                         HorizontalAlignment="Center" Margin="0,4,0,2"/>
              <TextBlock Text="{Binding Path=card4Shards}" Foreground="#FF888888" FontSize="13"
                         HorizontalAlignment="Center"/>
              <Border CornerRadius="8" Padding="12,6" Margin="0,6,0,0"
                      Background="#FF888833" HorizontalAlignment="Center">
                <TextBlock Text="Upgrade" Foreground="#FFFFFFEE" FontSize="13"
                           HorizontalAlignment="Center"/>
              </Border>
            </StackPanel>
          </Border>
        </UniformGrid>

        <!-- CHEST SLOTS -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
          <Border CornerRadius="8" Width="80" Height="80" Margin="6" Background="#FF2A2A4E">
            <TextBlock Text="{Binding Path=chest1Text}" Foreground="#FFAAAAAA" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center"/>
          </Border>
          <Border CornerRadius="8" Width="80" Height="80" Margin="6" Background="#FF2A2A4E">
            <TextBlock Text="{Binding Path=chest2Text}" Foreground="#FFAAAAAA" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center"/>
          </Border>
          <Border CornerRadius="8" Width="80" Height="80" Margin="6" Background="#FF2A2A4E">
            <TextBlock Text="{Binding Path=chest3Text}" Foreground="#FFAAAAAA" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center"/>
          </Border>
          <Border CornerRadius="8" Width="80" Height="80" Margin="6" Background="#FF2A2A4E">
            <TextBlock Text="{Binding Path=chest4Text}" Foreground="#FFAAAAAA" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center"/>
          </Border>
        </StackPanel>

        <!-- WIN RATE + START BUTTON -->
        <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,6,0,16">
          <!-- Win rate -->
          <TextBlock Text="{Binding Path=winRateText}" Foreground="#FF999999" FontSize="14"
                     HorizontalAlignment="Center" Margin="0,0,0,12"/>

          <!-- Start Battle Button -->
          <Button Command="{Binding Path=events.onStartBattle}" Margin="0">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="BtnBorder" CornerRadius="24" Padding="60,16">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#FF4488FF" Offset="0"/>
                      <GradientStop Color="#FF2266DD" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <TextBlock Text="Start Battle" Foreground="#FFFFFFFF"
                             FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                </Border>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </noesis:LayoutScaler>
</Component>
